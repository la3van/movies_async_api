# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

PROJECT_NAME=events-etl


# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------

KAFKA_BOOTSTRAP_SERVERS=kafka-0:9092,kafka-1:9092,kafka-2:9092

KAFKA_TOPIC=user-events

KAFKA_GROUP_ID=events-clickhouse-etl

KAFKA_CLIENT_ID=events-etl

# Намеренно earliest: обычные рестарты продолжают с committed offsets.
# Если offsets отсутствуют/потеряны, история перечитывается из Kafka.
# Replay безопасен благодаря дедупликации ClickHouse по event_id.
KAFKA_AUTO_OFFSET_RESET=earliest

KAFKA_BATCH_SIZE=500

KAFKA_POLL_TIMEOUT_SECONDS=1.0

KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_ENABLE_AUTO_OFFSET_STORE=false

KAFKA_RETRY_INITIAL_DELAY_SECONDS=1
KAFKA_RETRY_MAX_DELAY_SECONDS=30


# -----------------------------------------------------------------------------
# ClickHouse
# -----------------------------------------------------------------------------

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123

CLICKHOUSE_USERNAME=events_etl
CLICKHOUSE_PASSWORD=generate_me

CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_TABLE=user_events

CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=5
CLICKHOUSE_SEND_RECEIVE_TIMEOUT_SECONDS=30

CLICKHOUSE_MAX_RETRIES=0
CLICKHOUSE_RETRY_INITIAL_DELAY_SECONDS=1
CLICKHOUSE_RETRY_MAX_DELAY_SECONDS=30


# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------

METRICS_HOST=0.0.0.0
METRICS_PORT=9100
# -----------------------------------------------------------------------------
# Dead Letter Queue
# -----------------------------------------------------------------------------

KAFKA_DLQ_TOPIC=user-events-dlq
KAFKA_DLQ_CLIENT_ID=events-etl-dlq
KAFKA_DLQ_DELIVERY_TIMEOUT_MS=5000
KAFKA_DLQ_FLUSH_TIMEOUT_SECONDS=5

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=events_etl@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0