# Application
PROJECT_NAME=ugc-service
API_VERSION=1.0.0
MAX_REQUEST_BODY_BYTES=65536

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=ugc
MONGO_USERNAME=ugc_user
MONGO_PASSWORD=ugc_password
MONGO_AUTH_DATABASE=admin
MONGO_CONNECT_TIMEOUT_MS=2000
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5

# Redis / rate limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=4
REDIS_SOCKET_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1
REDIS_MAX_RETRIES=2
REDIS_RETRY_BACKOFF_BASE=0.1
REDIS_RETRY_BACKOFF_CAP=1.0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_PREFIX=ugc:rate_limit

# Auth Service
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8000
AUTH_SERVICE_API_PREFIX=/api/v1
AUTH_SERVICE_CONNECT_TIMEOUT=1
AUTH_SERVICE_READ_TIMEOUT=2
AUTH_ALLOW_JWT_FALLBACK=true
JWT_SECRET_KEY=replace_with_the_auth_service_jwt_secret
JWT_ALGORITHM=HS256

# Content Service film validation
CONTENT_SERVICE_HOST=content-service
CONTENT_SERVICE_PORT=8000
CONTENT_SERVICE_API_PREFIX=/api/v1
CONTENT_SERVICE_CONNECT_TIMEOUT=1
CONTENT_SERVICE_READ_TIMEOUT=2
CONTENT_VALIDATE_FILMS=true

# OpenTelemetry / Jaeger
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ugc-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=x-request-id

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=ugc_service@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0