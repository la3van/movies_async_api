# Async API project
PROJECT_NAME=movies-async-api

# Elasticsearch
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_REQUEST_TIMEOUT=30
ELASTIC_MOVIES_INDEX=movies
ELASTIC_GENRES_INDEX=genres
ELASTIC_PERSONS_INDEX=persons

ELASTIC_MAX_RETRIES=2
ELASTIC_RETRY_ON_TIMEOUT=True
ELASTIC_RETRY_ON_STATUS='[429, 502, 503, 504]'
ELASTIC_RETRY_BACKOFF_BASE=0.1
ELASTIC_RETRY_BACKOFF_CAP=1.0

# FilmService
FILM_SORT_FIELDS='{"imdb_rating": "imdb_rating"}'
FILM_CACHE_EXPIRE_IN_SECONDS=300

# GenreService
GENRE_SORT_FIELDS='{"name": "name.raw"}'
GENRE_CACHE_EXPIRE_IN_SECONDS=300

# PersonService
PERSON_SORT_FIELDS='{"full_name": "full_name.raw"}'
PERSON_CACHE_EXPIRE_IN_SECONDS=300

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

REDIS_MAX_RETRIES=2
REDIS_RETRY_BACKOFF_BASE=0.1
REDIS_RETRY_BACKOFF_CAP=1.0

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_PREFIX=content:rate_limit

# Tracing
OTEL_ENABLED=true
OTEL_SERVICE_NAME=content-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=x-request-id

# Auth Service
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8000
AUTH_SERVICE_API_PREFIX=/api/v1
AUTH_SERVICE_CONNECT_TIMEOUT=1
AUTH_SERVICE_READ_TIMEOUT=2

AUTH_PERMISSION_CACHE_TTL=60

# JWT
JWT_SECRET_KEY=secret_from_auth_service # для тестового прогона cab3ccbc07c3a51e70d67a2f1d5b737a92e4e9da6732ae48c94a1c5d67f0e9d368c71772667a043ec460bd83b41add77f95750207dde06b6aacb713b4888d405
JWT_ALGORITHM=HS256