# Auth API project
PROJECT_NAME=auth-service
DEBUG=false

# Auth API
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=8000

# PostgreSQL
POSTGRES_HOST=auth-postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=auth_password
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2
REDIS_KEY_PREFIX=auth
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_MAX_RETRIES=2
REDIS_RETRY_BACKOFF_BASE=0.1
REDIS_RETRY_BACKOFF_CAP=1.0

# Cache
USER_CACHE_EXPIRE_IN_SECONDS=300
ROLE_CACHE_EXPIRE_IN_SECONDS=300
PERMISSION_CACHE_EXPIRE_IN_SECONDS=300
TOKEN_CLAIMS_CACHE_EXPIRE_IN_SECONDS=300
LOGIN_HISTORY_CACHE_EXPIRE_IN_SECONDS=60

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_PREFIX=auth:rate_limit

# Trusted reverse proxies
TRUSTED_PROXY_SOURCES=nginx,admin-service

# OAuth
OAUTH_STATE_TTL_SECONDS=300
OAUTH_STATE_KEY_PREFIX=oauth:state
OAUTH_HTTP_TIMEOUT_SECONDS=10

# Yandex OAuth
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/yandex/callback
YANDEX_OAUTH_SCOPES=login:info login:email

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile

# VK ID OAuth
# TODO: VK ID requires a trusted public HTTPS domain.
# localhost and temporary trycloudflare.com domains are rejected.
VK_OAUTH_CLIENT_ID=
VK_OAUTH_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/vk/callback
VK_OAUTH_SCOPES=email

# JWT
JWT_SECRET_KEY=generate_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Access token revocation
ACCESS_TOKEN_REVOCATION_KEY_PREFIX=access_tokens:revoked
ACCESS_TOKEN_REVOCATION_CLOCK_SKEW_SECONDS=30

# Superuser
SUPERUSER_LOGIN=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=generate_me
SUPERUSER_FIRST_NAME=admin
SUPERUSER_LAST_NAME=User

# Tracing
OTEL_ENABLED=true
OTEL_SERVICE_NAME=auth-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=x-request-id