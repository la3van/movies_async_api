# Test service
SERVICE_URL=http://auth-service:8000
API_PREFIX=/api/v1
HTTP_REQUEST_TIMEOUT=10

# Test-only application settings
JWT_SECRET_KEY=functional_test_jwt_secret_key
SUPERUSER_PASSWORD=functional_test_superuser_password
OTEL_ENABLED=false

# PostgreSQL
POSTGRES_HOST=auth-postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth_test
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=auth_password
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=auth-test
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_MAX_RETRIES=2
REDIS_RETRY_BACKOFF_BASE=0.1
REDIS_RETRY_BACKOFF_CAP=1.0

# Connection waiting
WAIT_ATTEMPTS=30
WAIT_SLEEP_SECONDS=1