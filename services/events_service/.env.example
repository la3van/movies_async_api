# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

PROJECT_NAME=events-service
MAX_EVENT_REQUEST_BYTES=65536

# -----------------------------------------------------------------------------
# Gunicorn
# -----------------------------------------------------------------------------

GUNICORN_BIND=0.0.0.0:8000

GUNICORN_WORKERS=2
GUNICORN_WORKER_CONNECTIONS=1000

GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=10
GUNICORN_KEEPALIVE=5

GUNICORN_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------

KAFKA_BOOTSTRAP_SERVERS=kafka-0:9092,kafka-1:9092,kafka-2:9092
KAFKA_TOPIC=user-events
KAFKA_CLIENT_ID=events-service

# Гарантии producer
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true

# Небольшое batching-окно перед отправкой
KAFKA_LINGER_MS=5

# Сжатие сообщений
KAFKA_COMPRESSION_TYPE=lz4

# Максимальное время, за которое librdkafka должа доставить сообщение
KAFKA_DELIVERY_TIMEOUT_MS=5000

# Сколько HTTP-запрос ждёт подтверждение доставки своего события
KAFKA_ACK_TIMEOUT_SECONDS=6

# Readiness check Kafka 
KAFKA_METADATA_TIMEOUT_SECONDS=2

# Ожидание оставшихся сообщений при shutdown
KAFKA_FLUSH_TIMEOUT_SECONDS=5

# Частота cooperative poll Kafka callbacks в gevent worker
KAFKA_POLL_INTERVAL_SECONDS=0.01

# -----------------------------------------------------------------------------
# OpenTelemetry / Jaeger
# -----------------------------------------------------------------------------

OTEL_ENABLED=true
OTEL_SERVICE_NAME=events-service

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=true

OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=x-request-id
# -----------------------------------------------------------------------------
# Auth Service
# -----------------------------------------------------------------------------

AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8000
AUTH_SERVICE_API_PREFIX=/api/v1
AUTH_SERVICE_CONNECT_TIMEOUT_SECONDS=1
AUTH_SERVICE_READ_TIMEOUT_SECONDS=2

# -----------------------------------------------------------------------------
# Redis / event rate limiting
# -----------------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=3
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

EVENT_RATE_LIMIT_ENABLED=true
EVENT_RATE_LIMIT_KEY_PREFIX=events:rate-limit
EVENT_RATE_LIMIT_REQUESTS=120
EVENT_RATE_LIMIT_WINDOW_SECONDS=60