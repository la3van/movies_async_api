# PostgreSQL
POSTGRES_HOST=theatre-db
POSTGRES_PORT=5432
POSTGRES_DB=theatre
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me # for study project password is "secret"
POSTGRES_OPTIONS="-c search_path=public,content"
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# Elasticsearch
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_REQUEST_TIMEOUT=30
MOVIES_INDEX=movies
GENRES_INDEX=genres
PERSONS_INDEX=persons

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_STATE_KEY_PREFIX=etl_state
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# ETL
BATCH_SIZE=100
ETL_SLEEP_TIME=1

# Backoff
BACKOFF_START_SLEEP_TIME=0.1
BACKOFF_FACTOR=2
BACKOFF_BORDER_SLEEP_TIME=10
BACKOFF_JITTER=True