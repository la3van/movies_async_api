# Admin service
PROJECT_NAME=admin-service
DEBUG=true
ENABLE_DEBUG_TOOLBAR=false

# Django
SECRET_KEY=generate_me # для тестового прогона lkUJXUK6hOfWLh5YLN1w_lP5YuO5P_sF9Kfji0K5mQz-0DUnxuU657sln9Ey7oNpp0s2svcsZ9MxdeU0SKE0MQ
ALLOWED_HOSTS=localhost,127.0.0.1,admin-service
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# Admin service
ADMIN_SERVICE_HOST=0.0.0.0
ADMIN_SERVICE_PORT=8000

# SQLite
SQLITE_PATH=/app/data/admin.sqlite3

# PostgreSQL
POSTGRES_HOST=theatre-db
POSTGRES_PORT=5432
POSTGRES_DB=theatre
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me # для тестового прогона secret
POSTGRES_OPTIONS="-c search_path=public,content"
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# Auth service
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8000
AUTH_SERVICE_API_PREFIX=/api/v1
AUTH_SERVICE_CONNECT_TIMEOUT=5
AUTH_SERVICE_READ_TIMEOUT=5

# Django session
SESSION_COOKIE_AGE=900

# Gunicorn
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120