DATABASE_URL=postgresql+asyncpg://delivery:delivery@notification-postgres/deliveries

KAFKA_BOOTSTRAP_SERVERS=kafka-0:9092,kafka-1:9092,kafka-2:9092
JOBS_TOPIC=notification-delivery-v1
DLQ_TOPIC=notification-delivery-v1-dlq
RESULTS_TOPIC=notification-results-v1
EVENTS_TOPIC=cinema-events-v1
FAILED_TOPIC=notification-failed-v1
CONSUMER_GROUP=notification-worker-v1

AUTH_BASE_URL=http://auth-service:8000/api/v1/
# Совпадает с NOTIFICATION_WORKER_TOKEN в Auth.
INTERNAL_TOKEN=notification-worker-local-test

# Mailpit принимает письма без логина и пароля.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_MODE=plain
SMTP_SENDER=cinema@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=20

MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=3600
LEASE_SECONDS=180

SENTRY_DSN=
OTEL_ENDPOINT=http://jaeger:4317
SERVICE_NAME=notification_worker

PROFILE_BASE_URL=http://profile-service:8000/api/v1/
PROFILE_TOKEN=generate_me
